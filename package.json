{
  "name": "codex-opencode-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "MCP bridge that lets Codex delegate bounded coding tasks to OpenCode",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.11.0",
  "bin": {
    "bridge-mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:mcp": "tsx src/mcp/server.ts",
    "start:mcp": "node dist/mcp/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
