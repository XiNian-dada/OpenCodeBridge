{
  "name": "codex-opencode-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "MCP bridge that lets Codex delegate bounded coding tasks to OpenCode",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.11.0",
  "bin": {
    "bridge-mcp": "./dist/mcp/server.js",
    "bridge": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-viewer-assets.mjs && node scripts/write-build-info.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:mcp": "tsx src/mcp/server.ts",
    "start:mcp": "node dist/mcp/server.js",
    "dev:cli": "tsx src/cli/index.ts",
    "acceptance": "bash scripts/acceptance.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "better-sqlite3": "13.0.3",
    "entities": "8.1.0",
    "marked": "18.1.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "linkedom": "0.18.14",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
